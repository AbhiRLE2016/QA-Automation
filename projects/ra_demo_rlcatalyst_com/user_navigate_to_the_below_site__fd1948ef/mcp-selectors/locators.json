{
  "login_page": {
    "email_input": ["input#email", "input[name='email']"],
    "password_input": ["input#password", "input[name='password']"],
    "sign_in_button": ["button.submit-btn-enterprise:has-text('Sign In')", "button[type='submit']:has-text('Sign In')"],
    "session_expired_toast": [".toast-message:has-text('Session Expired')"],
    "toast_close": ["button.toast-close-button"]
  },
  "organization_page": {
    "heading_my_organizations": ["h1:has-text('My Organizations')"],
    "breadcrumb_label": ["nav[aria-label='breadcrumb'] li", "navigation[aria-label='breadcrumb'] li"]
  },
  "side_nav": {
    "menu_toggle": ["button[aria-label='Open navigation menu']"],
    "users_nav_button": ["nav button.nav-btn:has-text('Users')"]
  },
  "users_page": {
    "page_url_fragment": ["/users"],
    "heading_users": ["h1:has-text('Users')"],
    "user_card_by_name_tpl": [".users-container .item:has(.user-name-text[title='{name}'])"],
    "user_card_three_dots_tpl": [".users-container .item:has(.user-name-text[title='{name}']) button.user-card-menu-trigger"],
    "menu_option_delete_user_tpl": [".users-container .item:has(.user-name-text[title='{name}']) .user-card-menu-dropdown.open span.user-card-menu-option:has-text('Delete User')"],
    "all_user_name_texts": [".users-container .user-name-text"]
  },
  "delete_user_modal": {
    "container": ["[role='dialog']:has(h2.Header:has-text('Delete User'))"],
    "header": ["[role='dialog'] h2.Header:has-text('Delete User')"],
    "body_text": ["[role='dialog'] label.details", "[role='dialog'] .modal-body label"],
    "confirm_button": ["[role='dialog'] button.l-submit:has-text('Delete User')", "[role='dialog'] button:has-text('Delete User')"]
  }
}
