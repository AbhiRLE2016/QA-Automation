{
  "login_page": {
    "session_expired_close": [
      "button[aria-label='Close']",
      "div.alert button:has-text('×')",
      ".toast-close-button"
    ],
    "sign_in_heading": [
      "h1:has-text('Sign in')",
      "h1.font-class:has-text('Sign in')"
    ],
    "email_input": [
      "#email",
      "input[name='email']",
      "input[placeholder='Please enter your Email ID']"
    ],
    "password_input": [
      "#password",
      "input[name='password']",
      "input[placeholder='Please enter your password']"
    ],
    "sign_in_button": [
      "button.submit-btn-enterprise",
      "button:has-text('Sign In')"
    ]
  },
  "my_organizations_page": {
    "page_title": [
      "h1.page-title:has-text('My Organizations')",
      "h1.page-title",
      ".page-title"
    ],
    "breadcrumb": [
      "[aria-label='breadcrumb']",
      "nav[aria-label='breadcrumb']"
    ],
    "add_new_button": [
      "[aria-label='Add new organization']",
      "div.create-organization-container",
      "[role='button']:has-text('Add New')"
    ],
    "organization_card": [
      ".organization-card"
    ],
    "organization_card_title": [
      "h3.project-name",
      ".organization-card h3"
    ]
  },
  "create_organization_page": {
    "toast_close": [
      ".ngx-toastr .toast-close-button",
      ".toast-error .toast-close-button",
      "div.overlay-container button[aria-label='Close']",
      "button[aria-label='Close']"
    ],
    "toast_container": [
      ".ngx-toastr.toast-error",
      "div[toast-component]"
    ],
    "heading": [
      "h3:has-text('Create Organization')",
      ".create-org-title"
    ],
    "name_input": [
      "#OrganizationName",
      "input[name='organizationName']:visible",
      "input[placeholder='Please enter your organization name - (required)']"
    ],
    "description_input": [
      "#Organizationdescription",
      "textarea[name='organizationDescription']:visible",
      "textarea[placeholder='Please enter your organization description - (required)']"
    ],
    "create_button": [
      "button.create-org-btn",
      "button.create-org-btn:has-text('Create Organization')"
    ]
  }
}
