{
  "login": {
    "heading": ["h2:has-text('PLI System Login')"],
    "manager_id_input": ["#manager-id", "input[aria-label='Manager ID']"],
    "password_input": ["#password", "input[aria-label='Password']"],
    "submit_button": ["button[type=submit]", "button:has-text('Login')"],
    "login_button": ["button[data-testid='login-button']"]
  },
  "dashboard": {
    "welcome_label": ["nav p:has-text('Welcome')"],
    "manager_name": ["nav p:has-text('Welcome') + p"],
    "tile_total_employees": ["main p:has-text('Total Employees')"],
    "tile_total_revenue": ["main p:has-text('Total Revenue')"],
    "tile_growth": ["main p:has-text('Growth %')"],
    "tile_active_departments": ["main p:has-text('Active Departments')"],
    "tab_manage_employees": ["button[data-testid='tab-manage-employees']"],
    "tab_manage_revenue": ["button[data-testid='tab-manage-revenue']"],
    "manage_employees_tab": [
      "button[data-testid='tab-manage-employees']",
      "button:has-text('Manage Employees')"
    ],
    "manage_revenue_tab": [
      "button[data-testid='tab-manage-revenue']",
      "button:has-text('Manage Revenue')"
    ],
    "add_employee_button": ["button[data-testid='add-employee-button']"],
    "add_revenue_button": ["button[data-testid='add-revenue-button']"],
    "upload_review_button": ["button[data-testid='upload-review-button']"],
    "set_performance_button": ["button[data-testid='set-performance-button']"],
    "show_pli_button": ["button[data-testid='show-pli-button']"],
    "modify_performance_button": ["button[data-testid='modify-performance-button']"],
    "view_all_employees": [
      "button[data-testid='view-all-employees-button']",
      "button:has-text('View All Employees')"
    ],
    "employee_row": ["table tbody tr"],
    "employees_table": ["table"],
    "employees_table_rows": ["table tbody tr"],
    "delete_employee_button": ["button[aria-label='Delete employee {id}']"],
    "delete_modal_confirm": ["button[data-testid='delete-modal-confirm-button']"],
    "bulk_delete_button": [
      "[data-testid='bulk-delete-button']",
      "button:has-text('Bulk Delete')"
    ],
    "confirm_modal_heading": [
      "h2:has-text('Bulk Delete Employees')",
      "h2:has-text('Delete')"
    ],
    "confirm_modal_message": [
      "p:has-text('Are you sure you want to delete')",
      "[role='dialog'] p"
    ],
    "confirm_delete_button": [
      "[data-testid='bulk-delete-modal-confirm-button']",
      "button:has-text(/^Delete \\d+$/)"
    ],
    "confirm_modal_cancel": ["button:has-text('Cancel')"]
  },
  "all_employees": {
    "header": ["h1:has-text('Company Directory')", "h1, h2"],
    "filter_dropdown": ["#dept-filter", "select"],
    "search_box": [
      "input[aria-label='Search employees']",
      "input[type=search]",
      "input[placeholder*='Search']"
    ],
    "table": ["table"],
    "rows": ["table tbody tr"],
    "row_cells": ["table tbody tr td"],
    "page_indicator": ["text=/Page \\d+ of \\d+/"],
    "next_page": ["button[title='Next page']"],
    "prev_page": ["button[title='Previous page']"],
    "scope_summary": ["text=/All departments . \\d+ employees in scope/"],
    "no_match_message": ["table tbody:has-text('No employees match')"]
  },
  "add_employee": {
    "form": ["form"],
    "heading": ["h1:has-text('Add New Employee'), h2:has-text('Add New Employee'), h3:has-text('Add New Employee')"],
    "employee_name_input": ["#employee-name"],
    "employee_id_input": ["#employee-id"],
    "grade_input": ["#grade"],
    "employment_type_input": ["#employment-type"],
    "ctc_input": ["#ctc"],
    "fixed_pay_input": ["#fixed-pay"],
    "variable_pay_input": ["#variable-pay"],
    "employee_status_input": ["#employee-status"],
    "email_input": ["#email"],
    "department_select": ["#department"],
    "project_select": ["#project"],
    "submit_button": ["button[data-testid='submit-add-employee']"]
  },
  "set_performance": {
    "heading": ["h1:has-text('Set Performance'), h2:has-text('Set Performance'), h3:has-text('Set Performance')"],
    "quarter_select": ["#quarter"],
    "emp_id_select": ["#empId"],
    "kpi_name_input": ["#kpi-name-{idx}"],
    "threshold_input": ["#threshold-{idx}"],
    "target_input": ["#target-{idx}"],
    "achieved_input": ["#achieved-{idx}"],
    "weightage_input": ["#weightage-{idx}"],
    "add_more_kpi_button": ["button[data-testid='add-more-kpi-button']"],
    "save_all_kpis_button": ["button[data-testid='save-all-kpis-button']"]
  },
  "add_revenue": {
    "heading": ["h1:has-text('Add Revenue'), h2:has-text('Add Revenue'), h3:has-text('Add Revenue')"],
    "employee_select": ["#employee"],
    "employee_name_input": ["#employee-name"],
    "revenue_id_input": ["#revenue-id"],
    "month_input": ["#month"],
    "cost_input": ["#cost"],
    "cost_currency_input": ["#cost-currency"],
    "revenue_input": ["#revenue"],
    "revenue_currency_input": ["#revenue-currency"],
    "submit_button": ["button[data-testid='submit-add-revenue']"]
  },
  "show_pli": {
    "heading": ["h1:has-text('PLI Data'), h2:has-text('PLI Data'), h3:has-text('PLI Data')"],
    "pli_table": ["table"],
    "emp_id_button": ["button:has-text('{id}')"]
  },
  "employee_pli": {
    "header_emp_id_value": ["span:has-text('Emp ID:') >> span"],
    "header_name_value": ["span:has-text('Name:') >> span"],
    "header_manager_id_value": ["span:has-text('Manager ID:') >> span"],
    "header_manager_value": ["span:has-text('Manager:') >> span"],
    "kpi_table": ["table"]
  }
}
