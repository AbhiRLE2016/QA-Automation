{
  "login": {
    "manager_id_input": ["#manager-id"],
    "password_input": ["#password"],
    "login_button": ["button[type='submit']:has-text('Login')", "button:has-text('Login')"]
  },
  "dashboard": {
    "welcome_label": ["nav p:has-text('Welcome')"],
    "manager_name": ["nav p:has-text('Welcome') + p"],
    "tile_total_employees": ["main p:has-text('Total Employees') + h3"],
    "tile_total_revenue": ["main p:has-text('Total Revenue') + h3"],
    "tile_growth": ["main p:has-text('Growth %') + h3"],
    "tile_active_departments": ["main p:has-text('Active Departments') + h3"],
    "tab_manage_employees": ["button:has-text('Manage Employees')"],
    "tab_manage_revenue": ["button:has-text('Manage Revenue')"],
    "add_employee_button": ["button:has(span:has-text('Add Employee'))", "button:has-text('Add Employee')"],
    "add_revenue_button": ["button:has-text('Add Revenue')"],
    "upload_review_button": ["button:has-text('Upload Review')"],
    "set_performance_button": ["button:has-text('Set Performance')"],
    "show_pli_button": ["button:has-text('Show PLI')"],
    "modify_performance_button": ["button:has-text('Modify Performance')"],
    "employees_table_rows": ["tbody tr"]
  },
  "add_employee": {
    "heading": ["h1:has-text('Add New Employee')"],
    "employee_name": ["#employee-name"],
    "employee_id": ["#employee-id"],
    "grade": ["#grade"],
    "employment_type": ["#employment-type"],
    "ctc": ["#ctc"],
    "fixed_pay": ["#fixed-pay"],
    "variable_pay": ["#variable-pay"],
    "employee_status": ["#employee-status"],
    "email": ["#email"],
    "department": ["#department"],
    "project": ["#project"],
    "submit_button": ["button[type='submit']:has-text('Add Employee')"]
  },
  "set_performance": {
    "heading": ["h1:has-text('Set Performance')"],
    "quarter": ["#quarter"],
    "emp_id": ["#empId"],
    "kpi_name": ["#kpi-name-{i}"],
    "threshold": ["#threshold-{i}"],
    "target": ["#target-{i}"],
    "achieved": ["#achieved-{i}"],
    "weightage": ["#weightage-{i}"],
    "add_more_kpi": ["button:has-text('Add More KPI')"],
    "save_all_kpis": ["button[type='submit']:has-text('Save All KPIs')"]
  },
  "add_revenue": {
    "heading": ["h1:has-text('Add Revenue')"],
    "employee_dropdown": ["#employee"],
    "employee_name_readonly": ["#employee-name"],
    "revenue_id": ["#revenue-id"],
    "month": ["#month"],
    "cost": ["#cost"],
    "cost_currency": ["#cost-currency"],
    "revenue": ["#revenue"],
    "revenue_currency": ["#revenue-currency"],
    "submit_button": ["button[type='submit']:has-text('Add Revenue')"]
  },
  "show_pli": {
    "heading": ["h1:has-text('Show PLI')"],
    "table_title": ["h3:has-text('PLI Data')"],
    "table": ["table"],
    "row_by_emp_id": ["tbody tr:has(button:has-text('{emp_id}'))"],
    "emp_id_link": ["tbody tr:has(button:has-text('{emp_id}')) button"]
  },
  "show_employee_pli": {
    "header_block": ["h1"],
    "kpi_rows": ["table tbody tr"]
  }
}
