{
  "login": {
    "url": "http://localhost:5173/",
    "manager_id_input": ["#manager-id", "input[data-testid='manager-id-input']", "input[aria-label='Manager ID']"],
    "password_input": ["#password", "input[data-testid='password-input']", "input[aria-label='Password']"],
    "submit": ["button:has-text('Login')"],
    "welcome_name": ["nav p:has-text('Welcome') + p", "nav p:nth-of-type(2)"]
  },
  "dashboard": {
    "url_pattern": "**/dashboard/**",
    "view_all_employees": ["button:has-text('View All Employees')"],
    "manage_employees_tab": ["button:has-text('Manage Employees')"]
  },
  "all_employees": {
    "url_pattern": "**/all-employees/**",
    "page_heading": ["h1:has-text('Company Directory')"],
    "dept_filter": ["#dept-filter", "select#dept-filter"],
    "showing_banner": ["main >> text=/Showing .+/"],
    "download_csv": ["button:has-text('Download CSV')"],
    "table": ["main table"],
    "rows": ["main table tbody tr"],
    "row_dept_cell": ["main table tbody tr"]
  }
}
